# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# testing artefacts
/playwright-report
/test-results
/.playwright

# AI agent rules, memory and session logs: local only, never committed
AGENTS.md
CLAUDE.md
GEMINI.md
.claude/
.codex/
.cursor/
.github/copilot-instructions.md
/docs/

# .env.example is the documented contract, keep it tracked
!.env.example
